# ─────────────────────────────────────────────────────────────
# EchoSync AI — environment configuration
# Copy to .env and fill in. Every value below has a safe default;
# you only NEED a GROQ_API_KEY if you want the cloud fallback.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
ECHOSYNC_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# CORS origins for the Next.js frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Engine routing ───────────────────────────────────────────
# auto  -> probe GPU at handshake, pick local if VRAM headroom allows
# local -> force local pipeline (fails loudly if CUDA missing)
# cloud -> force Groq pipeline
ENGINE_MODE=auto

# Minimum FREE VRAM (GB) required to route a session to the local engine.
MIN_FREE_VRAM_GB=6.0

# If the GPU crosses this temperature (C), new sessions degrade to cloud.
GPU_THERMAL_LIMIT_C=85

# ── Local pipeline ───────────────────────────────────────────
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

KOKORO_MODEL_PATH=./models/kokoro-v0_19.onnx
KOKORO_VOICES_PATH=./models/voices.bin
KOKORO_VOICE=af_sky
KOKORO_DEVICE=cuda

SILERO_VAD_PATH=./models/silero_vad.onnx

# ── Cloud pipeline (Groq) ────────────────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.1-8b-instant
# Cloud TTS: kokoro-onnx (CPU, local file) | edge (Microsoft EdgeTTS, free)
CLOUD_TTS_PROVIDER=kokoro-onnx
EDGE_TTS_VOICE=en-US-AriaNeural

# ── Audio pipeline tuning ────────────────────────────────────
SAMPLE_RATE=16000
FRAME_MS=32
# Consecutive silence before we close an utterance and run STT.
END_OF_UTTERANCE_SILENCE_MS=800
# Consecutive silence (after the AI has spoken) before [USER_STALLED] fires.
STALL_SILENCE_MS=4000
# Pre-roll kept in the ring buffer so we never clip the first phoneme.
PREROLL_MS=320
# Allow the user to interrupt the AI mid-sentence.
BARGE_IN_ENABLED=true

# ── Storage ──────────────────────────────────────────────────
DATABASE_PATH=./data/echosync.db
EXPORT_DIR=./data/exports
# Sessions are bound to client IP; this is the max distinct users kept.
MAX_TRACKED_USERS=5
# Turns of conversation kept in the LLM context window.
CONTEXT_WINDOW_TURNS=12
